<phone:PhoneApplicationPage
x:Class="LumiaYD.MainPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
mc:Ignorable="d"
FontFamily="{StaticResource PhoneFontFamilyNormal}"
FontSize="{StaticResource PhoneFontSizeNormal}"
Foreground="{StaticResource PhoneForegroundBrush}"
SupportedOrientations="Portrait" Orientation="Portrait"
shell:SystemTray.IsVisible="True">

    <Grid x:Name="LayoutRoot" Background="Black">

        <!-- ГЛАВНЫЙ ЭКРАН -->
        <phone:Pivot x:Name="MainPivot" Title="ЯНДЕКС ДИСК" Visibility="Collapsed" Foreground="White" SelectionChanged="MainPivot_SelectionChanged">

            <!-- ВКЛАДКА 1: ОБЛАКО -->
            <phone:PivotItem Header="облако">
                <Grid Margin="12,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Хлебные крошки -->
                    <Border Grid.Row="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                        <TextBlock x:Name="CurrentPathText" Text="диск /" Foreground="#999999" FontSize="20" Margin="0,8,0,12" FontFamily="Segoe UI Semibold"/>
                    </Border>

                    <!-- Список файлов -->
                    <ListBox x:Name="FilesListBox" Grid.Row="1" SelectionChanged="FilesListBox_SelectionChanged" Hold="FilesListBox_Hold">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="0,16,0,16"
                                        Opacity="{Binding DimOpacity}">
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="22" Foreground="White" TextWrapping="NoWrap" FontFamily="Segoe UI Semilight"/>
                                        <TextBlock Text="{Binding Info}" FontSize="16" Foreground="#666666" Margin="0,4,0,0" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </phone:PivotItem>

            <!-- ВКЛАДКА 2: ЗАГРУЗКИ (НОВЫЙ ДИЗАЙН) -->
            <phone:PivotItem Header="загрузки">
                <Grid Margin="12,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SyncStatusText" Text="Нет активных задач" Foreground="#666666" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Semilight"/>

                    <ListBox x:Name="TransferListBox" Grid.Row="1" Margin="0,12,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Иконка направления -->
                                        <Path Grid.Column="0" Data="{Binding IconPath}" Fill="{Binding IconColor}" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <!-- Информация о файле -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding FileName}" FontSize="20" Foreground="White" TextWrapping="NoWrap" FontFamily="Segoe UI Semilight"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="14" Foreground="#999999" Margin="0,2,0,0"/>
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,6,0,0" Foreground="#0078D7" Background="#333333"/>
                                        </StackPanel>

                                        <!-- Процент или статус -->
                                        <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontSize="16" Foreground="#999999" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Segoe UI Semibold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </phone:PivotItem>

            <!-- ВКЛАДКА 3: ИНФО -->
            <phone:PivotItem Header="инфо">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,32">
                        <Border Background="Transparent" Tap="AccountBlock_Tap" Margin="0,0,0,32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ТЕКУЩИЙ АККАУНТ" Foreground="#666666" FontSize="14" FontFamily="Segoe UI Semibold"/>
                                    <TextBlock x:Name="CurrentAccountText" Text="Не указан" FontSize="24" Foreground="White" Margin="0,8,0,0" FontFamily="Segoe UI Semilight" TextTrimming="WordEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}" FontSize="22"
                                           Foreground="#666666" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="ХРАНИЛИЩЕ" Foreground="#666666" FontSize="14" FontFamily="Segoe UI Semibold"/>
                        <TextBlock x:Name="StorageText" Text="Загрузка..." FontSize="24" Foreground="White" Margin="0,8,0,32" FontFamily="Segoe UI Semilight"/>

                        <TextBlock Text="ПОСЛЕДНИЕ СОБЫТИЯ" Foreground="#666666" FontSize="14" FontFamily="Segoe UI Semibold"/>
                        <TextBlock x:Name="DiagnosticsText" Text="Записей нет." FontSize="11" Foreground="#999999"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </phone:PivotItem>
        </phone:Pivot>

        <!-- НИЖНИЕ ОСТРОВА -->
        <StackPanel x:Name="BottomIslands" VerticalAlignment="Bottom" Canvas.ZIndex="90" Visibility="Collapsed">

            <!-- ОСТРОВ ВЫБРАННОГО ОБЪЕКТА -->
            <Border x:Name="SelectedIsland" Style="{StaticResource NothingFloatingCard}"
                    Margin="16,0,16,10" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedIslandTypeIcon" Text="&#xE230;"
                                       FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                       Foreground="{StaticResource NothingInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedIslandTitle" FontSize="17" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingInkBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SelectedIslandSubtitle" FontSize="10" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingMutedLightBrush}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource NothingCloseButton}" Width="36" Height="36"
                                Click="SelectedIslandClose_Click" VerticalAlignment="Center">
                            <TextBlock Text="&#xE4F6;" FontFamily="{StaticResource PhosphorFont}" FontSize="16"
                                       Foreground="{StaticResource NothingInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- ДЕЙСТВИЯ С ФАЙЛОМ -->
                    <Grid x:Name="FileActionsGrid" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource NothingActionTile}" Click="SelectedDownload_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE20C;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="СКАЧАТЬ" Style="{StaticResource NothingActionTileLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource NothingActionTile}" Click="SelectedRename_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE3B4;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ПЕРЕИМЕНОВАТЬ" Style="{StaticResource NothingActionTileLabel}" FontSize="9"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource NothingActionTile}" Click="SelectedDelete_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource NothingRedSoftBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE4A6;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingRedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="УДАЛИТЬ" Style="{StaticResource NothingActionTileLabel}"
                                           Foreground="{StaticResource NothingRedBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource NothingActionTile}" Click="SelectedProperties_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE2CE;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="СВОЙСТВА" Style="{StaticResource NothingActionTileLabel}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ДЕЙСТВИЯ С ПАПКОЙ -->
                    <Grid x:Name="FolderActionsGrid" Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource NothingActionTile}" Click="SelectedOpenFolder_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE256;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ОТКРЫТЬ" Style="{StaticResource NothingActionTileLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource NothingActionTile}" Click="SelectedDownloadAll_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE20C;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="СКАЧАТЬ ВСЁ" Style="{StaticResource NothingActionTileLabel}" FontSize="9"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource NothingActionTile}" Click="SelectedRename_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE3B4;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ПЕРЕИМЕНОВАТЬ" Style="{StaticResource NothingActionTileLabel}" FontSize="9"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource NothingActionTile}" Click="SelectedDelete_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource NothingRedSoftBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE4A6;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingRedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="УДАЛИТЬ" Style="{StaticResource NothingActionTileLabel}"
                                           Foreground="{StaticResource NothingRedBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ОСТРОВ ТЕКУЩЕЙ ПАПКИ -->
            <Border x:Name="DirectoryIsland" Style="{StaticResource NothingFloatingCard}"
                    Background="{StaticResource NothingGraphiteBrush}"
                    BorderBrush="{StaticResource NothingBorderDarkBrush}"
                    Margin="16,0,16,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ТЕКУЩАЯ ПАПКА" FontSize="10" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingMutedDarkBrush}"/>
                            <TextBlock x:Name="DirectoryPathText" Text="диск /" FontSize="15" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingWhiteBrush}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource NothingCloseButton}" Width="36" Height="36"
                                Background="#14FFFFFF" Click="DirectoryCollapse_Click" VerticalAlignment="Center">
                            <TextBlock Text="&#xE136;" FontFamily="{StaticResource PhosphorFont}" FontSize="16"
                                       Foreground="{StaticResource NothingWhiteBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource NothingDarkPillButton}" Margin="0,0,4,0"
                                Click="UploadFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE4C0;" FontFamily="{StaticResource PhosphorFont}" FontSize="17"
                                           Foreground="{StaticResource NothingWhiteBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="ЗАГРУЗИТЬ" Style="{StaticResource NothingDarkPillLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource NothingDarkPillButton}" Margin="4,0,4,0"
                                Click="CreateFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE258;" FontFamily="{StaticResource PhosphorFont}" FontSize="17"
                                           Foreground="{StaticResource NothingWhiteBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="СОЗДАТЬ" Style="{StaticResource NothingDarkPillLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource NothingDarkPillButton}" Margin="4,0,0,0"
                                Click="RefreshFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE094;" FontFamily="{StaticResource PhosphorFont}" FontSize="17"
                                           Foreground="{StaticResource NothingWhiteBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="ОБНОВИТЬ" Style="{StaticResource NothingDarkPillLabel}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- СВЁРНУТЫЙ МИКРО-ОСТРОВ -->
            <Border x:Name="DirectoryMicroIsland" Visibility="Collapsed" HorizontalAlignment="Center"
                    Background="{StaticResource NothingGraphiteBrush}"
                    BorderBrush="{StaticResource NothingBorderDarkBrush}" BorderThickness="1"
                    CornerRadius="22" Height="44" Padding="16,0" Margin="0,0,0,16"
                    Tap="DirectoryMicroIsland_Tap">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE24A;" FontFamily="{StaticResource PhosphorFont}" FontSize="16"
                               Foreground="{StaticResource NothingWhiteBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="ДЕЙСТВИЯ С ПАПКОЙ" FontSize="10" FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource NothingWhiteBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="&#xE13C;" FontFamily="{StaticResource PhosphorFont}" FontSize="13"
                               Foreground="{StaticResource NothingMutedDarkBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ЭКРАН АВТОРИЗАЦИИ -->
        <Grid x:Name="AuthArea" Canvas.ZIndex="100" Background="Black">
            <StackPanel VerticalAlignment="Center" Margin="32,0,32,0">
                <TextBlock Text="ЯНДЕКС ДИСК" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" FontFamily="Segoe UI Semilight"/>
                <TextBlock Text="ВОЙДИТЕ В АККАУНТ" Foreground="#666666" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,32" FontFamily="Segoe UI"/>

                <TextBlock Text="ЛОГИН" Foreground="#666666" FontSize="14" FontFamily="Segoe UI Semibold"/>
                <TextBox x:Name="LoginTextBox" Margin="0,4,0,16" FontSize="22" Background="#1F1F1F" Foreground="White" BorderBrush="#333333">
                    <TextBox.InputScope>
                        <InputScope>
                            <InputScopeName NameValue="EmailSmtpAddress"/>
                        </InputScope>
                    </TextBox.InputScope>
                </TextBox>

                <TextBlock Text="ПАРОЛЬ ПРИЛОЖЕНИЯ" Foreground="#666666" FontSize="14" FontFamily="Segoe UI Semibold"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,4,0,24" FontSize="22" Background="#1F1F1F" Foreground="White" BorderBrush="#333333"/>

                <Button x:Name="LoginButton" Content="ВОЙТИ" Click="LoginButton_Click" Height="72" Background="#0078D7" Foreground="White" FontSize="22" FontFamily="Segoe UI Semibold"/>
                <ProgressBar x:Name="AuthProgress" IsIndeterminate="True" Visibility="Collapsed" Height="4" Margin="0,16,0,0" Foreground="#0078D7" Background="#333333"/>
                <TextBlock x:Name="StatusText" Text="ВВЕДИТЕ ЛОГИН И ПАРОЛЬ ПРИЛОЖЕНИЯ" Foreground="#999999" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0" FontFamily="Segoe UI"/>
                <TextBlock Text="Пароль приложения создаётся в Яндекс ID → Безопасность → Пароли приложений. Обычный пароль от аккаунта не подойдёт." Foreground="#666666" FontSize="12" TextWrapping="Wrap" Margin="0,24,0,0" FontFamily="Segoe UI"/>
            </StackPanel>
        </Grid>

        <!-- МОДАЛЬНЫЙ СЛОЙ: МЕНЮ АККАУНТА И КАРТОЧКА ПОДТВЕРЖДЕНИЯ -->
        <Grid x:Name="ModalOverlay" Canvas.ZIndex="200" Visibility="Collapsed">
            <Border x:Name="ModalBackdrop" Background="#B3000000" Tap="ModalOverlay_Tap"/>
            <Border x:Name="AccountMenuCard" Style="{StaticResource NothingSheetCard}"
                    VerticalAlignment="Bottom" Margin="16,0,16,24" Tap="AccountMenuCard_Tap">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="24"/>
                </Border.RenderTransform>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="АККАУНТ" Style="{StaticResource NothingSheetCaption}"/>
                            <TextBlock x:Name="AccountMenuLogin" Text="Не указан" Style="{StaticResource NothingSheetTitle}"
                                       FontSize="22" Margin="0,4,0,0" TextTrimming="WordEllipsis"/>
                            <TextBlock Text="Яндекс.Диск · WebDAV" Style="{StaticResource NothingRowCaption}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource NothingCloseButton}"
                                Click="AccountMenuClose_Click" VerticalAlignment="Top">
                            <TextBlock Text="&#xE4F6;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                       Foreground="{StaticResource NothingInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="ХРАНИЛИЩЕ" Style="{StaticResource NothingSheetCaption}" Margin="0,24,0,0"/>
                    <Border x:Name="AccountStorageTrack" Height="4" CornerRadius="2" Background="#E4E4E1"
                            Margin="0,12,0,8" SizeChanged="AccountStorageTrack_SizeChanged">
                        <Border x:Name="AccountStorageFill" Background="{StaticResource NothingInkBrush}"
                                CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                    </Border>
                    <TextBlock x:Name="AccountStorageText" Text="Загрузка..." Style="{StaticResource NothingRowCaption}"/>

                    <Border Height="1" Background="{StaticResource NothingBorderLightBrush}" Margin="0,20,0,12"/>

                    <Button Style="{StaticResource NothingRowButton}" Click="AccountMenuRefresh_Click">
                        <Grid Height="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="#F0F0EE" VerticalAlignment="Center">
                                <TextBlock Text="&#xE094;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                           Foreground="{StaticResource NothingInkBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Обновить данные" Style="{StaticResource NothingRowTitle}"/>
                                <TextBlock Text="Папка и занятое место" Style="{StaticResource NothingRowCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}"
                                       FontSize="18" Foreground="#9A9A9A" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource NothingRowButton}" Click="AccountMenuLogout_Click" Margin="0,4,0,0">
                        <Grid Height="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource NothingRedSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE42A;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                           Foreground="{StaticResource NothingRedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Выйти" Style="{StaticResource NothingRowTitle}"
                                           Foreground="{StaticResource NothingRedBrush}"/>
                                <TextBlock Text="Отключить аккаунт на устройстве" Style="{StaticResource NothingRowCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}"
                                       FontSize="18" Foreground="{StaticResource NothingRedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- КАРТОЧКА ПОДТВЕРЖДЕНИЯ: ТО ЖЕ МЕСТО, ЧТО У МЕНЮ АККАУНТА -->
            <Border x:Name="NothingDialogCard" Style="{StaticResource NothingSheetCard}"
                    VerticalAlignment="Bottom" Margin="16,0,16,24" Tap="NothingDialogCard_Tap"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform X="480"/>
                </Border.RenderTransform>

                <StackPanel>
                    <TextBlock x:Name="NothingDialogTitle" Style="{StaticResource NothingDialogTitle}"/>
                    <TextBlock x:Name="NothingDialogMessage" Style="{StaticResource NothingDialogBody}" Margin="0,10,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="NothingDialogSecondaryButton" Style="{StaticResource NothingSecondaryButton}"
                                Click="NothingDialogSecondary_Click" Margin="0,0,8,0"/>
                        <Button x:Name="NothingDialogPrimaryButton" Style="{StaticResource NothingPrimaryButton}"
                                Click="NothingDialogPrimary_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>