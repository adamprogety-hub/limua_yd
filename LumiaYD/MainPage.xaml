<phone:PhoneApplicationPage
    x:Class="LumiaYD.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <phone:PhoneApplicationPage.Resources>
        <!-- Шаблон строки передачи (Metro UI: плоская строка, тонкий прогресс-бар, воздушная иконка) -->
        <DataTemplate x:Key="TransferRowTemplate">
            <Border Background="Transparent"
                    BorderBrush="{StaticResource MetroDividerBrush}" BorderThickness="0,0,0,1"
                    Padding="24,12"
                    Tap="TransferRow_Tap">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Воздушная иконка передачи (без рамок и фона) -->
                    <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource PhosphorFont}"
                               FontSize="24" Foreground="{Binding IconBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontSize="18"
                                   Foreground="#FFFFFF"
                                   FontFamily="Segoe UI Semilight" TextWrapping="NoWrap"
                                   TextTrimming="WordEllipsis"/>
                        <TextBlock Text="{Binding TargetText}" FontSize="11"
                                   Foreground="{StaticResource MetroMutedBrush}"
                                   FontFamily="Segoe UI" Margin="0,2,0,0"
                                   TextWrapping="NoWrap" TextTrimming="WordEllipsis"/>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="2"
                                     Margin="0,6,0,0" Foreground="#FFFFFF"
                                     Background="{StaticResource MetroSubtleBorderBrush}"
                                     BorderThickness="0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   Foreground="{StaticResource MetroMutedBrush}"
                                   FontFamily="Segoe UI" Margin="0,3,0,0"
                                   TextWrapping="NoWrap" TextTrimming="WordEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ProgressText}" FontSize="13"
                                   Foreground="#FFFFFF"
                                   FontFamily="Segoe UI Semibold" HorizontalAlignment="Right"/>
                        <TextBlock Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}" FontSize="12"
                                   Foreground="#555555"
                                   HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="Black">

        <!-- ГЛАВНЫЙ ЭКРАН (METRO PIVOT) -->
        <phone:Pivot x:Name="MainPivot" Title="ЯНДЕКС ДИСК" Visibility="Collapsed" Foreground="White" SelectionChanged="MainPivot_SelectionChanged">

            <!-- ВКЛАДКА 1: ОБЛАКО -->
            <phone:PivotItem Header="облако">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Хлебные крошки текущего пути -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource MetroDividerBrush}" BorderThickness="0,0,0,1" Margin="24,0,24,6">
                        <TextBlock x:Name="CurrentPathText" Text="диск /" Foreground="{StaticResource MetroMutedBrush}" FontSize="18" Margin="0,4,0,8" FontFamily="Segoe UI Semibold"/>
                    </Border>

                    <!-- Список файлов (Metro UI: чистые строки, воздушные иконки без рамок) -->
                    <ListBox x:Name="FilesListBox" Grid.Row="1" SelectionChanged="FilesListBox_SelectionChanged"
                             Hold="FilesListBox_Hold" Background="Transparent" BorderThickness="0"
                             Padding="0" HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentControl x:Name="ContentControl"
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding RowBorderBrush}" BorderThickness="0,0,0,1"
                                        Background="{Binding RowBackground}"
                                        Opacity="{Binding DimOpacity}" Tap="FileRow_Tap">
                                    <Grid Margin="24,14,24,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Воздушная иконка Phosphor (без кругов, рамок и фона) -->
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="{StaticResource PhosphorFont}"
                                                   FontSize="26"
                                                   Foreground="{Binding RowNameBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="20" Foreground="{Binding RowNameBrush}" TextWrapping="NoWrap" FontFamily="Segoe UI Semilight"/>
                                            <TextBlock Text="{Binding Info}" FontSize="13" Foreground="{Binding RowInfoBrush}" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </phone:PivotItem>

            <!-- ВКЛАДКА 2: ПЕРЕДАЧИ -->
            <phone:PivotItem Header="передачи">
                <Grid>
                    <ScrollViewer x:Name="TransfersScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,24">

                            <!-- ПУСТОЕ СОСТОЯНИЕ (Чистый Metro стиль) -->
                            <Border x:Name="TransfersEmptyState"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="24,32,24,0">
                                <StackPanel>
                                    <TextBlock Text="&#xE20C;" FontFamily="{StaticResource PhosphorFont}"
                                               FontSize="48" Foreground="#444444"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="нет активных передач" FontSize="26"
                                               Foreground="#FFFFFF"
                                               FontFamily="Segoe UI Light" Margin="0,16,0,0"/>
                                    <TextBlock Text="Здесь появятся загрузки на Диск и скачивания на телефон."
                                               FontSize="14" Foreground="{StaticResource MetroMutedBrush}"
                                               FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <Button Style="{StaticResource MetroPrimaryButton}"
                                            Content="открыть облако"
                                            HorizontalAlignment="Left" Margin="0,22,0,0"
                                            Click="OpenCloudFromTransfers_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- АКТИВНЫЕ ПЕРЕДАЧИ -->
                            <StackPanel x:Name="ActiveTransfersSection" Visibility="Collapsed">
                                <TextBlock x:Name="ActiveTransfersTitle" Text="АКТИВНЫЕ"
                                           FontSize="12" FontFamily="Segoe UI Semibold"
                                           Foreground="{StaticResource MetroMutedBrush}"
                                           Margin="24,16,24,8"/>
                                <ItemsControl x:Name="ActiveTransfersList"
                                              ItemTemplate="{StaticResource TransferRowTemplate}"/>
                            </StackPanel>

                            <!-- ЗАВЕРШЁННЫЕ ПЕРЕДАЧИ -->
                            <StackPanel x:Name="CompletedTransfersSection" Visibility="Collapsed"
                                        Margin="0,16,0,0">
                                <Grid Margin="24,0,24,8">
                                    <TextBlock x:Name="CompletedTransfersTitle" Text="ЗАВЕРШЁННЫЕ"
                                               FontSize="12" FontFamily="Segoe UI Semibold"
                                               Foreground="{StaticResource MetroMutedBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="ClearCompletedButton"
                                            Style="{StaticResource NothingLinkButton}"
                                            HorizontalAlignment="Right"
                                            Visibility="Collapsed"
                                            Click="ClearCompletedTransfers_Click">
                                        <TextBlock Text="ОЧИСТИТЬ" Style="{StaticResource NothingLinkLabel}"/>
                                    </Button>
                                </Grid>
                                <ItemsControl x:Name="CompletedTransfersList"
                                              ItemTemplate="{StaticResource TransferRowTemplate}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </phone:PivotItem>

            <!-- ВКЛАДКА 3: ИНФО -->
            <phone:PivotItem Header="инфо">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,16,24,32">
                        <Border Background="Transparent" Tap="AccountBlock_Tap" Margin="0,0,0,28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ТЕКУЩИЙ АККАУНТ" Foreground="{StaticResource MetroMutedBrush}" FontSize="12" FontFamily="Segoe UI Semibold"/>
                                    <TextBlock x:Name="CurrentAccountText" Text="Не указан" FontSize="26" Foreground="White" Margin="0,6,0,0" FontFamily="Segoe UI Light" TextTrimming="WordEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                           Foreground="#555555" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="{StaticResource MetroDividerBrush}" Margin="0,0,0,24"/>

                        <TextBlock Text="ХРАНИЛИЩЕ" Foreground="{StaticResource MetroMutedBrush}" FontSize="12" FontFamily="Segoe UI Semibold"/>
                        <TextBlock x:Name="StorageText" Text="Загрузка..." FontSize="26" Foreground="White" Margin="0,6,0,28" FontFamily="Segoe UI Light"/>

                        <Border Height="1" Background="{StaticResource MetroDividerBrush}" Margin="0,0,0,24"/>

                        <TextBlock Text="ПОСЛЕДНИЕ СОБЫТИЯ" Foreground="{StaticResource MetroMutedBrush}" FontSize="12" FontFamily="Segoe UI Semibold"/>
                        <TextBlock x:Name="DiagnosticsText" Text="Записей нет." FontSize="11" Foreground="#666666"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </phone:PivotItem>
        </phone:Pivot>

        <!-- НИЖНЯЯ ПАНЕЛЬ ДЕЙСТВИЙ (METRO BOTTOM ACTION BAR: ЧИСТЫЕ ВОЗДУШНЫЕ ИКОНКИ PHOSPHOR) -->
        <StackPanel x:Name="BottomIslands" VerticalAlignment="Bottom" Canvas.ZIndex="90" Visibility="Collapsed">

            <!-- ПАНЕЛЬ ВЫБРАННОГО ОБЪЕКТА (ФАЙЛА ИЛИ ПАПКИ) -->
            <Border x:Name="SelectedIsland" Background="#000000" BorderBrush="{StaticResource MetroDividerBrush}"
                    BorderThickness="0,1,0,0" Padding="20,10,20,10" Visibility="Collapsed">
                <StackPanel>
                    <!-- Заголовок выбранного элемента + иконка типа + закрытие -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="SelectedIslandTypeIcon" Text="&#xE230;"
                                   FontFamily="{StaticResource PhosphorFont}" FontSize="22"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedIslandTitle" FontSize="17" FontFamily="Segoe UI Semilight"
                                       Foreground="#FFFFFF" TextTrimming="WordEllipsis"/>
                            <TextBlock x:Name="SelectedIslandSubtitle" FontSize="11" FontFamily="Segoe UI"
                                       Foreground="{StaticResource MetroMutedBrush}" Margin="0,1,0,0"
                                       TextTrimming="WordEllipsis"/>
                        </StackPanel>

                        <!-- Закрыть выбор -->
                        <Button Grid.Column="2" Style="{StaticResource MetroIconButton}" Width="44" Height="44"
                                Click="SelectedIslandClose_Click" VerticalAlignment="Center">
                            <TextBlock Text="&#xE4F6;" FontFamily="{StaticResource PhosphorFont}" FontSize="18"
                                       Foreground="{StaticResource MetroMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- ДЕЙСТВИЯ С ФАЙЛОМ: ЧИСТЫЕ ВОЗДУШНЫЕ ИКОНКИ (СКАЧАТЬ, ПЕРЕИМЕНОВАТЬ, УДАЛИТЬ, СВОЙСТВА) -->
                    <Grid x:Name="FileActionsGrid" Height="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource MetroIconButton}" Click="SelectedDownload_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE20C;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource MetroIconButton}" Click="SelectedRename_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE3B4;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource MetroIconButton}" Click="SelectedDelete_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE4A6;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="{StaticResource MetroRedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource MetroIconButton}" Click="SelectedProperties_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE2CE;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- ДЕЙСТВИЯ С ПАПКОЙ: ЧИСТЫЕ ВОЗДУШНЫЕ ИКОНКИ (ОТКРЫТЬ, СКАЧАТЬ АРХИВ, ПЕРЕИМЕНОВАТЬ, УДАЛИТЬ) -->
                    <Grid x:Name="FolderActionsGrid" Height="56" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource MetroIconButton}" Click="SelectedOpenFolder_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE256;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource MetroIconButton}" Click="SelectedDownloadAll_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE20C;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource MetroIconButton}" Click="SelectedRename_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE3B4;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource MetroIconButton}" Click="SelectedDelete_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE4A6;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="{StaticResource MetroRedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ПАНЕЛЬ ТЕКУЩЕЙ ПАПКИ (ПРИКРЕПЛЁННАЯ СНИЗУ ПОСТОЯННО ДОСТУПНАЯ ПАНЕЛЬ ДЕЙСТВИЙ) -->
            <Border x:Name="DirectoryIsland" Background="#000000" BorderBrush="{StaticResource MetroDividerBrush}"
                    BorderThickness="0,1,0,0" Padding="16,4,16,4">
                <StackPanel>
                    <!-- Скрытые элементы для 100% совместимости с C# логикой -->
                    <TextBlock x:Name="DirectoryPathText" Visibility="Collapsed"/>
                    <Button Style="{StaticResource MetroIconButton}" Width="0" Height="0" Visibility="Collapsed" Click="DirectoryCollapse_Click"/>

                    <!-- Чистые воздушные иконки действий папки (Загрузить, Создать папку, Обновить, Переименовать) -->
                    <Grid Height="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Загрузить файл -->
                        <Button Grid.Column="0" Style="{StaticResource MetroIconButton}" Click="UploadFile_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE4C0;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Создать папку -->
                        <Button Grid.Column="1" Style="{StaticResource MetroIconButton}" Click="CreateFolder_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE258;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Обновить список -->
                        <Button Grid.Column="2" Style="{StaticResource MetroIconButton}" Click="RefreshFolder_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE094;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Переименовать текущую папку (показывается только внутри папок, не в корне) -->
                        <Button x:Name="DirectoryRenameButton" Grid.Column="3" Style="{StaticResource MetroIconButton}"
                                Visibility="Collapsed" Click="DirectoryRename_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE3B4;" FontFamily="{StaticResource PhosphorFont}" FontSize="26"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- СВЁРНУТЫЙ МИКРО-ОСТРОВ (скрыт, сохранён для совместимости с C#) -->
            <Border x:Name="DirectoryMicroIsland" Visibility="Collapsed" Tap="DirectoryMicroIsland_Tap"/>

            <!-- ПАНЕЛЬ ДЕЙСТВИЙ С ВЫБРАННОЙ ПЕРЕДАЧЕЙ -->
            <Border x:Name="TransferIsland" Background="#000000" BorderBrush="{StaticResource MetroDividerBrush}"
                    BorderThickness="0,1,0,0" Padding="20,10,20,10" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TransferIslandIcon" Text="&#xE20C;"
                                   FontFamily="{StaticResource PhosphorFont}" FontSize="22"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TransferIslandTitle" FontSize="17"
                                       FontFamily="Segoe UI Semilight"
                                       Foreground="#FFFFFF"
                                       TextTrimming="WordEllipsis"/>
                            <TextBlock x:Name="TransferIslandSubtitle" FontSize="11"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource MetroMutedBrush}"
                                       Margin="0,1,0,0" TextTrimming="WordEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource MetroIconButton}"
                                Width="44" Height="44" Click="TransferIslandClose_Click"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE4F6;" FontFamily="{StaticResource PhosphorFont}" FontSize="18"
                                       Foreground="{StaticResource MetroMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- ОСТАНОВИТЬ АКТИВНУЮ -->
                    <Grid x:Name="TransferRunningActions" Height="56" Visibility="Collapsed">
                        <Button Style="{StaticResource MetroIconButton}" Click="TransferCancelAction_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE4F6;" FontFamily="{StaticResource PhosphorFont}"
                                       FontSize="26" Foreground="{StaticResource MetroRedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- ПОВТОРИТЬ ИЛИ УБРАТЬ -->
                    <Grid x:Name="TransferRetryRemoveActions" Height="56" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource MetroIconButton}"
                                Click="TransferRetryAction_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE094;" FontFamily="{StaticResource PhosphorFont}"
                                       FontSize="26" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource MetroIconButton}"
                                Click="TransferRemoveAction_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE4A6;" FontFamily="{StaticResource PhosphorFont}"
                                       FontSize="26" Foreground="{StaticResource MetroRedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- ТОЛЬКО УБРАТЬ -->
                    <Grid x:Name="TransferRemoveActions" Height="56" Visibility="Collapsed">
                        <Button Style="{StaticResource MetroIconButton}" Click="TransferRemoveAction_Click" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE4A6;" FontFamily="{StaticResource PhosphorFont}"
                                       FontSize="26" Foreground="{StaticResource MetroRedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ЭКРАН АВТОРИЗАЦИИ (METRO UI: ЧИСТЫЙ ЧЁРНЫЙ ЭКРАН, ВЫРАВНИВАНИЕ ПО ЦЕНТРУ, БЕЗ МУСОРА) -->
        <Grid x:Name="AuthArea" Canvas.ZIndex="100" Background="Black">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid MinHeight="760">
                    <StackPanel VerticalAlignment="Center" Margin="32,24,32,24">

                        <!-- Заголовок приложения по центру -->
                        <TextBlock Text="яндекс диск" FontSize="42" FontFamily="Segoe UI Light"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center"/>

                        <!-- Форма авторизации -->
                        <StackPanel Margin="0,44,0,0">
                            <TextBlock Text="ЛОГИН" FontSize="11" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource MetroMutedBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="LoginTextBox" Style="{StaticResource NothingAuthField}"
                                     KeyDown="LoginTextBox_KeyDown">
                                <TextBox.InputScope>
                                    <InputScope>
                                        <InputScopeName NameValue="EmailSmtpAddress"/>
                                    </InputScope>
                                </TextBox.InputScope>
                            </TextBox>

                            <Grid Margin="0,20,0,8">
                                <TextBlock Text="ПАРОЛЬ" FontSize="11" FontFamily="Segoe UI Semibold"
                                           Foreground="{StaticResource MetroMutedBrush}" VerticalAlignment="Center"/>
                                <Button x:Name="PasswordRevealButton" Style="{StaticResource NothingLinkButton}"
                                        HorizontalAlignment="Right" Click="PasswordRevealButton_Click">
                                    <TextBlock x:Name="PasswordRevealLabel" Text="ПОКАЗАТЬ"
                                               Style="{StaticResource NothingLinkLabel}"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource NothingAuthPasswordField}"
                                             PasswordChanged="PasswordBox_PasswordChanged"
                                             KeyDown="PasswordBox_KeyDown"/>
                                <TextBox x:Name="PasswordTextBox" Style="{StaticResource NothingAuthField}"
                                         Visibility="Collapsed" KeyDown="PasswordTextBox_KeyDown"
                                         TextChanged="PasswordTextBox_TextChanged"/>
                            </Grid>

                            <Button x:Name="LoginButton" Style="{StaticResource MetroPrimaryButton}"
                                    Height="52" HorizontalAlignment="Stretch"
                                    Margin="0,28,0,0" Click="LoginButton_Click">
                                <TextBlock x:Name="LoginButtonLabel" Text="ВОЙТИ"
                                           Style="{StaticResource NothingLightPillLabel}"/>
                            </Button>

                            <ProgressBar x:Name="AuthProgress" IsIndeterminate="True" Visibility="Collapsed"
                                         Height="2" Margin="0,16,0,0"
                                         Foreground="#FFFFFF"
                                         Background="{StaticResource MetroSubtleBorderBrush}"
                                         BorderThickness="0"/>
                            <TextBlock x:Name="StatusText" Text="ВВЕДИТЕ ЛОГИН И ПАРОЛЬ"
                                       Foreground="{StaticResource MetroMutedBrush}" FontSize="12"
                                       FontFamily="Segoe UI" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Margin="0,16,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- МОДАЛЬНЫЙ СЛОЙ: МЕНЮ АККАУНТА И КАРТОЧКА ПОДТВЕРЖДЕНИЯ (METRO UI: ЧЁРНЫЕ ПАНЕЛИ, 0 РАДИУС) -->
        <Grid x:Name="ModalOverlay" Canvas.ZIndex="200" Visibility="Collapsed">
            <Border x:Name="ModalBackdrop" Background="#CC000000" Tap="ModalOverlay_Tap"/>

            <!-- МЕНЮ АККАУНТА -->
            <Border x:Name="AccountMenuCard" Style="{StaticResource NothingSheetCard}"
                    VerticalAlignment="Bottom" Margin="0" Tap="AccountMenuCard_Tap">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="24"/>
                </Border.RenderTransform>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="АККАУНТ" Style="{StaticResource NothingSheetCaption}"/>
                            <TextBlock x:Name="AccountMenuLogin" Text="Не указан" Style="{StaticResource NothingSheetTitle}"
                                       FontSize="24" Margin="0,4,0,0" TextTrimming="WordEllipsis"/>
                            <TextBlock Text="Яндекс.Диск · WebDAV" Style="{StaticResource NothingRowCaption}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource MetroIconButton}" Width="44" Height="44"
                                Click="AccountMenuClose_Click" VerticalAlignment="Top">
                            <TextBlock Text="&#xE4F6;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                       Foreground="{StaticResource MetroMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="ХРАНИЛИЩЕ" Style="{StaticResource NothingSheetCaption}" Margin="0,24,0,0"/>
                    <Border x:Name="AccountStorageTrack" Height="4" CornerRadius="0" Background="{StaticResource MetroSubtleBorderBrush}"
                            Margin="0,10,0,8" SizeChanged="AccountStorageTrack_SizeChanged">
                        <Border x:Name="AccountStorageFill" Background="#FFFFFF"
                                CornerRadius="0" HorizontalAlignment="Left" Width="0"/>
                    </Border>
                    <TextBlock x:Name="AccountStorageText" Text="Загрузка..." Style="{StaticResource NothingRowCaption}"/>

                    <Border Height="1" Background="{StaticResource MetroDividerBrush}" Margin="0,20,0,12"/>

                    <!-- Обновить данные -->
                    <Button Style="{StaticResource NothingRowButton}" Click="AccountMenuRefresh_Click">
                        <Grid Height="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE094;" FontFamily="{StaticResource PhosphorFont}" FontSize="22"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Обновить данные" Style="{StaticResource NothingRowTitle}"/>
                                <TextBlock Text="Папка и занятое место" Style="{StaticResource NothingRowCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}"
                                       FontSize="16" Foreground="#555555" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Выйти из аккаунта -->
                    <Button Style="{StaticResource NothingRowButton}" Click="AccountMenuLogout_Click" Margin="0,4,0,0">
                        <Grid Height="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE42A;" FontFamily="{StaticResource PhosphorFont}" FontSize="22"
                                       Foreground="{StaticResource MetroRedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Выйти" Style="{StaticResource NothingRowTitle}"
                                           Foreground="{StaticResource MetroRedBrush}"/>
                                <TextBlock Text="Отключить аккаунт на устройстве" Style="{StaticResource NothingRowCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}"
                                       FontSize="16" Foreground="{StaticResource MetroRedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- КАРТОЧКА ПОДТВЕРЖДЕНИЯ И ВВОДА (METRO ДИАЛОГ) -->
            <Border x:Name="NothingDialogCard" Style="{StaticResource NothingSheetCard}"
                    VerticalAlignment="Bottom" Margin="0" Tap="NothingDialogCard_Tap"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform X="480"/>
                </Border.RenderTransform>

                <StackPanel>
                    <TextBlock x:Name="NothingDialogTitle" Style="{StaticResource NothingDialogTitle}"/>
                    <TextBlock x:Name="NothingDialogMessage" Style="{StaticResource NothingDialogBody}" Margin="0,10,0,0"/>

                    <Border x:Name="NothingDialogInputBorder" Visibility="Collapsed" Background="#000000"
                            BorderBrush="{StaticResource MetroSubtleBorderBrush}" BorderThickness="1.5"
                            CornerRadius="0" Margin="0,16,0,0" Padding="10,0">
                        <TextBox x:Name="NothingDialogInput" Height="48" BorderThickness="0"
                                 Background="Transparent" Foreground="#FFFFFF"
                                 FontSize="18" FontFamily="Segoe UI" Padding="0"
                                 VerticalContentAlignment="Center" MaxLength="255"
                                 KeyDown="NothingDialogInput_KeyDown"/>
                    </Border>

                    <TextBlock x:Name="NothingDialogError" Visibility="Collapsed" FontFamily="Segoe UI"
                               FontSize="12" Foreground="{StaticResource MetroRedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="NothingDialogSecondaryButton" Style="{StaticResource NothingSecondaryButton}"
                                Click="NothingDialogSecondary_Click" Margin="0,0,8,0"/>
                        <Button x:Name="NothingDialogPrimaryButton" Style="{StaticResource NothingPrimaryButton}"
                                Click="NothingDialogPrimary_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>
