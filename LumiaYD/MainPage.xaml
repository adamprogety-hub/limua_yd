<phone:PhoneApplicationPage
x:Class="LumiaYD.MainPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
mc:Ignorable="d"
FontFamily="{StaticResource PhoneFontFamilyNormal}"
FontSize="{StaticResource PhoneFontSizeNormal}"
Foreground="{StaticResource PhoneForegroundBrush}"
SupportedOrientations="Portrait" Orientation="Portrait"
shell:SystemTray.IsVisible="True">

    <phone:PhoneApplicationPage.Resources>
        <DataTemplate x:Key="TransferRowTemplate">
            <Border Background="{StaticResource NothingGraphiteBrush}"
                    BorderBrush="{StaticResource NothingBorderDarkBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="16,14" Margin="0,0,0,10"
                    Tap="TransferRow_Tap">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource NothingGraphiteRaisedBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource PhosphorFont}"
                                   FontSize="22" Foreground="{Binding IconBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontSize="19"
                                   Foreground="{StaticResource NothingWhiteBrush}"
                                   FontFamily="Segoe UI Semilight" TextWrapping="NoWrap"
                                   TextTrimming="WordEllipsis"/>
                        <TextBlock Text="{Binding TargetText}" FontSize="11"
                                   Foreground="{StaticResource NothingMutedDarkBrush}"
                                   FontFamily="Segoe UI Semibold" Margin="0,2,0,0"
                                   TextWrapping="NoWrap" TextTrimming="WordEllipsis"/>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4"
                                     Margin="0,8,0,0" Foreground="{StaticResource NothingWhiteBrush}"
                                     Background="{StaticResource NothingBorderDarkBrush}"
                                     BorderThickness="0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                   Foreground="{StaticResource NothingMutedDarkBrush}"
                                   FontFamily="Segoe UI" Margin="0,4,0,0"
                                   TextWrapping="NoWrap" TextTrimming="WordEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ProgressText}" FontSize="13"
                                   Foreground="{StaticResource NothingWhiteBrush}"
                                   FontFamily="Segoe UI Semibold" HorizontalAlignment="Right"/>
                        <TextBlock Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}" FontSize="12"
                                   Foreground="{StaticResource NothingMutedDarkBrush}"
                                   HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="LayoutRoot" Background="Black">

        <!-- ГЛАВНЫЙ ЭКРАН -->
        <phone:Pivot x:Name="MainPivot" Title="ЯНДЕКС ДИСК" Visibility="Collapsed" Foreground="White" SelectionChanged="MainPivot_SelectionChanged">

            <!-- ВКЛАДКА 1: ОБЛАКО -->
            <phone:PivotItem Header="облако">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Хлебные крошки -->
                    <Border Grid.Row="0" BorderBrush="#333333" BorderThickness="0,0,0,1" Margin="12,0,12,12">
                        <TextBlock x:Name="CurrentPathText" Text="диск /" Foreground="#999999" FontSize="20" Margin="0,8,0,12" FontFamily="Segoe UI Semibold"/>
                    </Border>

                    <!-- Список файлов -->
                    <ListBox x:Name="FilesListBox" Grid.Row="1" SelectionChanged="FilesListBox_SelectionChanged"
                             Hold="FilesListBox_Hold" Background="Transparent" BorderThickness="0"
                             Padding="0" HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentControl x:Name="ContentControl"
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding RowBorderBrush}" BorderThickness="0,0,0,1"
                                        Background="Transparent"
                                        Opacity="{Binding DimOpacity}" Tap="FileRow_Tap">
                                    <Border Background="{Binding RowBackground}"
                                            Padding="24,16,24,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="40" Height="40" CornerRadius="12"
                                                    Background="{StaticResource NothingGraphiteRaisedBrush}"
                                                    BorderBrush="{StaticResource NothingBorderDarkBrush}"
                                                    BorderThickness="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           FontFamily="{StaticResource PhosphorFont}"
                                                           FontSize="21"
                                                           Foreground="{StaticResource NothingWhiteBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="22" Foreground="{Binding RowNameBrush}" TextWrapping="NoWrap" FontFamily="Segoe UI Semilight"/>
                                                <TextBlock Text="{Binding Info}" FontSize="16" Foreground="{Binding RowInfoBrush}" Margin="0,4,0,0" FontFamily="Segoe UI"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </phone:PivotItem>

            <!-- ВКЛАДКА 2: ПЕРЕДАЧИ -->
            <phone:PivotItem Header="передачи">
                <Grid>
                    <ScrollViewer x:Name="TransfersScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,0,16,24">

                            <!-- ПУСТОЕ СОСТОЯНИЕ -->
                            <Border x:Name="TransfersEmptyState"
                                    Background="{StaticResource NothingGraphiteBrush}"
                                    BorderBrush="{StaticResource NothingBorderDarkBrush}"
                                    BorderThickness="1" CornerRadius="26" Padding="24"
                                    Margin="0,8,0,0">
                                <StackPanel>
                                    <Border Width="64" Height="64" CornerRadius="20"
                                            Background="{StaticResource NothingGraphiteRaisedBrush}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="&#xE20C;" FontFamily="{StaticResource PhosphorFont}"
                                                   FontSize="30" Foreground="{StaticResource NothingWhiteBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="ПОКА НИЧЕГО НЕТ" FontSize="22"
                                               Foreground="{StaticResource NothingWhiteBrush}"
                                               FontFamily="Segoe UI Semilight" Margin="0,18,0,0"/>
                                    <TextBlock Text="Здесь появятся загрузки на Диск и скачивания на телефон."
                                               FontSize="13" Foreground="{StaticResource NothingMutedDarkBrush}"
                                               FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <Button Style="{StaticResource NothingDarkPillButton}"
                                            HorizontalAlignment="Left" Margin="0,18,0,0"
                                            Click="OpenCloudFromTransfers_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE24A;" FontFamily="{StaticResource PhosphorFont}"
                                                       FontSize="17" Foreground="{StaticResource NothingWhiteBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="ОТКРЫТЬ ОБЛАКО" Style="{StaticResource NothingDarkPillLabel}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- АКТИВНЫЕ ПЕРЕДАЧИ -->
                            <StackPanel x:Name="ActiveTransfersSection" Visibility="Collapsed">
                                <TextBlock x:Name="ActiveTransfersTitle" Text="АКТИВНЫЕ"
                                           FontSize="11" FontFamily="Segoe UI Semibold"
                                           Foreground="{StaticResource NothingMutedDarkBrush}"
                                           Margin="4,0,4,10"/>
                                <ItemsControl x:Name="ActiveTransfersList"
                                              ItemTemplate="{StaticResource TransferRowTemplate}"/>
                            </StackPanel>

                            <!-- ЗАВЕРШЁННЫЕ ПЕРЕДАЧИ -->
                            <StackPanel x:Name="CompletedTransfersSection" Visibility="Collapsed"
                                        Margin="0,16,0,0">
                                <Grid Margin="4,0,4,10">
                                    <TextBlock x:Name="CompletedTransfersTitle" Text="ЗАВЕРШЁННЫЕ"
                                               FontSize="11" FontFamily="Segoe UI Semibold"
                                               Foreground="{StaticResource NothingMutedDarkBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="ClearCompletedButton"
                                            Style="{StaticResource NothingDarkPillButton}"
                                            Height="34" Padding="12,0" HorizontalAlignment="Right"
                                            Visibility="Collapsed"
                                            Click="ClearCompletedTransfers_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE4A6;" FontFamily="{StaticResource PhosphorFont}"
                                                       FontSize="14" Foreground="{StaticResource NothingWhiteBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="ОЧИСТИТЬ" Style="{StaticResource NothingDarkPillLabel}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ItemsControl x:Name="CompletedTransfersList"
                                              ItemTemplate="{StaticResource TransferRowTemplate}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </phone:PivotItem>

            <!-- ВКЛАДКА 3: ИНФО -->
            <phone:PivotItem Header="инфо">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,32">
                        <Border Background="Transparent" Tap="AccountBlock_Tap" Margin="0,0,0,32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ТЕКУЩИЙ АККАУНТ" Foreground="#666666" FontSize="14" FontFamily="Segoe UI Semibold"/>
                                    <TextBlock x:Name="CurrentAccountText" Text="Не указан" FontSize="24" Foreground="White" Margin="0,8,0,0" FontFamily="Segoe UI Semilight" TextTrimming="WordEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}" FontSize="22"
                                           Foreground="#666666" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="ХРАНИЛИЩЕ" Foreground="#666666" FontSize="14" FontFamily="Segoe UI Semibold"/>
                        <TextBlock x:Name="StorageText" Text="Загрузка..." FontSize="24" Foreground="White" Margin="0,8,0,32" FontFamily="Segoe UI Semilight"/>

                        <TextBlock Text="ПОСЛЕДНИЕ СОБЫТИЯ" Foreground="#666666" FontSize="14" FontFamily="Segoe UI Semibold"/>
                        <TextBlock x:Name="DiagnosticsText" Text="Записей нет." FontSize="11" Foreground="#999999"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </phone:PivotItem>
        </phone:Pivot>

        <!-- НИЖНИЕ ОСТРОВА -->
        <StackPanel x:Name="BottomIslands" VerticalAlignment="Bottom" Canvas.ZIndex="90" Visibility="Collapsed">

            <!-- ОСТРОВ ВЫБРАННОГО ОБЪЕКТА -->
            <Border x:Name="SelectedIsland" Style="{StaticResource NothingFloatingCard}"
                    Margin="16,0,16,10" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedIslandTypeIcon" Text="&#xE230;"
                                       FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                       Foreground="{StaticResource NothingInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedIslandTitle" FontSize="17" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingInkBrush}" TextTrimming="WordEllipsis"/>
                            <TextBlock x:Name="SelectedIslandSubtitle" FontSize="10" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingMutedLightBrush}" Margin="0,2,0,0"
                                       TextTrimming="WordEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource NothingCloseButton}" Width="36" Height="36"
                                Click="SelectedIslandClose_Click" VerticalAlignment="Center">
                            <TextBlock Text="&#xE4F6;" FontFamily="{StaticResource PhosphorFont}" FontSize="16"
                                       Foreground="{StaticResource NothingInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- ДЕЙСТВИЯ С ФАЙЛОМ -->
                    <Grid x:Name="FileActionsGrid" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource NothingActionTile}" Click="SelectedDownload_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE20C;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="СКАЧАТЬ" Style="{StaticResource NothingActionTileLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource NothingActionTile}" Click="SelectedRename_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE3B4;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ПЕРЕИМЕНОВАТЬ" Style="{StaticResource NothingActionTileLabel}" FontSize="9"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource NothingActionTile}" Click="SelectedDelete_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource NothingRedSoftBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE4A6;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingRedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="УДАЛИТЬ" Style="{StaticResource NothingActionTileLabel}"
                                           Foreground="{StaticResource NothingRedBrush}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource NothingActionTile}" Click="SelectedProperties_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE2CE;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="СВОЙСТВА" Style="{StaticResource NothingActionTileLabel}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ДЕЙСТВИЯ С ПАПКОЙ -->
                    <Grid x:Name="FolderActionsGrid" Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource NothingActionTile}" Click="SelectedOpenFolder_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE256;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ОТКРЫТЬ" Style="{StaticResource NothingActionTileLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource NothingActionTile}" Click="SelectedDownloadAll_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE20C;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="СКАЧАТЬ ВСЁ" Style="{StaticResource NothingActionTileLabel}" FontSize="9"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource NothingActionTile}" Click="SelectedRename_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE3B4;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ПЕРЕИМЕНОВАТЬ" Style="{StaticResource NothingActionTileLabel}" FontSize="9"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource NothingActionTile}" Click="SelectedDelete_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource NothingRedSoftBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE4A6;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                               Foreground="{StaticResource NothingRedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="УДАЛИТЬ" Style="{StaticResource NothingActionTileLabel}"
                                           Foreground="{StaticResource NothingRedBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ОСТРОВ ТЕКУЩЕЙ ПАПКИ -->
            <Border x:Name="DirectoryIsland" Style="{StaticResource NothingFloatingCard}"
                    Background="{StaticResource NothingGraphiteBrush}"
                    BorderBrush="{StaticResource NothingBorderDarkBrush}"
                    Margin="16,0,16,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ТЕКУЩАЯ ПАПКА" FontSize="10" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingMutedDarkBrush}"/>
                            <TextBlock x:Name="DirectoryPathText" Text="диск /" FontSize="15" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingWhiteBrush}" Margin="0,3,0,0"
                                       TextTrimming="WordEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource NothingCloseButton}" Width="36" Height="36"
                                Background="#14FFFFFF" Click="DirectoryCollapse_Click" VerticalAlignment="Center">
                            <TextBlock Text="&#xE136;" FontFamily="{StaticResource PhosphorFont}" FontSize="16"
                                       Foreground="{StaticResource NothingWhiteBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource NothingDarkPillButton}" Margin="0,0,4,0"
                                Click="UploadFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE4C0;" FontFamily="{StaticResource PhosphorFont}" FontSize="17"
                                           Foreground="{StaticResource NothingWhiteBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="ЗАГРУЗИТЬ" Style="{StaticResource NothingDarkPillLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource NothingDarkPillButton}" Margin="4,0,4,0"
                                Click="CreateFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE258;" FontFamily="{StaticResource PhosphorFont}" FontSize="17"
                                           Foreground="{StaticResource NothingWhiteBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="СОЗДАТЬ" Style="{StaticResource NothingDarkPillLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource NothingDarkPillButton}" Margin="4,0,0,0"
                                Click="RefreshFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE094;" FontFamily="{StaticResource PhosphorFont}" FontSize="17"
                                           Foreground="{StaticResource NothingWhiteBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="ОБНОВИТЬ" Style="{StaticResource NothingDarkPillLabel}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Button x:Name="DirectoryRenameButton" Style="{StaticResource NothingDarkPillButton}"
                            Margin="0,8,0,0" Visibility="Collapsed" Click="DirectoryRename_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE3B4;" FontFamily="{StaticResource PhosphorFont}" FontSize="17"
                                       Foreground="{StaticResource NothingWhiteBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="ПЕРЕИМЕНОВАТЬ" Style="{StaticResource NothingDarkPillLabel}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- СВЁРНУТЫЙ МИКРО-ОСТРОВ -->
            <Border x:Name="DirectoryMicroIsland" Visibility="Collapsed" HorizontalAlignment="Center"
                    Background="{StaticResource NothingGraphiteBrush}"
                    BorderBrush="{StaticResource NothingBorderDarkBrush}" BorderThickness="1"
                    CornerRadius="22" Height="44" Padding="16,0" Margin="0,0,0,16"
                    Tap="DirectoryMicroIsland_Tap">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE24A;" FontFamily="{StaticResource PhosphorFont}" FontSize="16"
                               Foreground="{StaticResource NothingWhiteBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="ДЕЙСТВИЯ С ПАПКОЙ" FontSize="10" FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource NothingWhiteBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Text="&#xE13C;" FontFamily="{StaticResource PhosphorFont}" FontSize="13"
                               Foreground="{StaticResource NothingMutedDarkBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- ОСТРОВ ПЕРЕДАЧИ -->
            <Border x:Name="TransferIsland" Style="{StaticResource NothingFloatingCard}"
                    Margin="16,0,16,10" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TransferIslandIcon" Text="&#xE20C;"
                                       FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                       Foreground="{StaticResource NothingInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TransferIslandTitle" FontSize="17"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingInkBrush}"
                                       TextTrimming="WordEllipsis"/>
                            <TextBlock x:Name="TransferIslandSubtitle" FontSize="10"
                                       FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingMutedLightBrush}"
                                       Margin="0,2,0,0" TextTrimming="WordEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource NothingCloseButton}"
                                Width="36" Height="36" Click="TransferIslandClose_Click"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE4F6;" FontFamily="{StaticResource PhosphorFont}" FontSize="16"
                                       Foreground="{StaticResource NothingInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- ОСТАНОВИТЬ АКТИВНУЮ -->
                    <Grid x:Name="TransferRunningActions" Margin="0,6,0,0" Visibility="Collapsed">
                        <Button Style="{StaticResource NothingActionTile}" Click="TransferCancelAction_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="{StaticResource NothingRedSoftBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE4F6;" FontFamily="{StaticResource PhosphorFont}"
                                               FontSize="20" Foreground="{StaticResource NothingRedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ОСТАНОВИТЬ" Style="{StaticResource NothingActionTileLabel}"
                                           FontSize="9" Foreground="{StaticResource NothingRedBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ПОВТОРИТЬ ИЛИ УБРАТЬ -->
                    <Grid x:Name="TransferRetryRemoveActions" Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource NothingActionTile}"
                                Click="TransferRetryAction_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21" Background="#EFEFED"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE094;" FontFamily="{StaticResource PhosphorFont}"
                                               FontSize="20" Foreground="{StaticResource NothingInkBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="ПОВТОРИТЬ" Style="{StaticResource NothingActionTileLabel}"
                                           FontSize="9"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Style="{StaticResource NothingActionTile}"
                                Click="TransferRemoveAction_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="{StaticResource NothingRedSoftBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE4A6;" FontFamily="{StaticResource PhosphorFont}"
                                               FontSize="20" Foreground="{StaticResource NothingRedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="УБРАТЬ" Style="{StaticResource NothingActionTileLabel}"
                                           Foreground="{StaticResource NothingRedBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ТОЛЬКО УБРАТЬ -->
                    <Grid x:Name="TransferRemoveActions" Margin="0,6,0,0" Visibility="Collapsed">
                        <Button Style="{StaticResource NothingActionTile}" Click="TransferRemoveAction_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="{StaticResource NothingRedSoftBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE4A6;" FontFamily="{StaticResource PhosphorFont}"
                                               FontSize="20" Foreground="{StaticResource NothingRedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="УБРАТЬ" Style="{StaticResource NothingActionTileLabel}"
                                           Foreground="{StaticResource NothingRedBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ЭКРАН АВТОРИЗАЦИИ -->
        <Grid x:Name="AuthArea" Canvas.ZIndex="100" Background="Black">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,36,24,36">

                    <Grid Width="64" Height="64" HorizontalAlignment="Left">
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="{StaticResource NothingGraphiteBrush}"
                                BorderBrush="{StaticResource NothingBorderDarkBrush}" BorderThickness="1"/>
                        <TextBlock Text="&#xE24A;" FontFamily="{StaticResource PhosphorFont}" FontSize="28"
                                   Foreground="{StaticResource NothingWhiteBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="ЯНДЕКС ДИСК" FontSize="34" FontFamily="Segoe UI Light"
                               Foreground="{StaticResource NothingWhiteBrush}" Margin="0,18,0,0"/>
                    <TextBlock Text="WEBDAV · NOKIA LUMIA 925" FontSize="10" FontFamily="Segoe UI Semibold"
                               Foreground="{StaticResource NothingMutedDarkBrush}" Margin="0,6,0,0"/>

                    <Border Background="{StaticResource NothingGraphiteBrush}"
                            BorderBrush="{StaticResource NothingBorderDarkBrush}" BorderThickness="1"
                            CornerRadius="26" Padding="20" Margin="0,28,0,0">
                        <StackPanel>
                            <TextBlock Text="ВХОД В АККАУНТ" FontSize="11" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingMutedDarkBrush}"/>

                            <TextBlock Text="ЛОГИН" FontSize="10" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingMutedDarkBrush}" Margin="2,18,0,6"/>
                            <TextBox x:Name="LoginTextBox" Style="{StaticResource NothingAuthField}"
                                     KeyDown="LoginTextBox_KeyDown">
                                <TextBox.InputScope>
                                    <InputScope>
                                        <InputScopeName NameValue="EmailSmtpAddress"/>
                                    </InputScope>
                                </TextBox.InputScope>
                            </TextBox>

                            <Grid Margin="2,16,2,6">
                                <TextBlock Text="ПАРОЛЬ ПРИЛОЖЕНИЯ" FontSize="10" FontFamily="Segoe UI Semibold"
                                           Foreground="{StaticResource NothingMutedDarkBrush}" VerticalAlignment="Center"/>
                                <Button x:Name="PasswordRevealButton" Style="{StaticResource NothingLinkButton}"
                                        HorizontalAlignment="Right" Click="PasswordRevealButton_Click">
                                    <TextBlock x:Name="PasswordRevealLabel" Text="ПОКАЗАТЬ"
                                               Style="{StaticResource NothingLinkLabel}"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource NothingAuthPasswordField}"
                                             PasswordChanged="PasswordBox_PasswordChanged"
                                             KeyDown="PasswordBox_KeyDown"/>
                                <TextBox x:Name="PasswordTextBox" Style="{StaticResource NothingAuthField}"
                                         Visibility="Collapsed" KeyDown="PasswordTextBox_KeyDown"
                                         TextChanged="PasswordTextBox_TextChanged"/>
                            </Grid>

                            <Button x:Name="LoginButton" Style="{StaticResource NothingLightPillButton}"
                                    Margin="0,20,0,0" Click="LoginButton_Click">
                                <TextBlock x:Name="LoginButtonLabel" Text="ВОЙТИ"
                                           Style="{StaticResource NothingLightPillLabel}"/>
                            </Button>

                            <ProgressBar x:Name="AuthProgress" IsIndeterminate="True" Visibility="Collapsed"
                                         Height="3" Margin="0,12,0,0"
                                         Foreground="{StaticResource NothingWhiteBrush}"
                                         Background="{StaticResource NothingBorderDarkBrush}"
                                         BorderThickness="0"/>
                            <TextBlock x:Name="StatusText" Text="ВВЕДИТЕ ЛОГИН И ПАРОЛЬ ПРИЛОЖЕНИЯ"
                                       Foreground="{StaticResource NothingMutedDarkBrush}" FontSize="12"
                                       FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="Transparent"
                            BorderBrush="{StaticResource NothingBorderDarkBrush}" BorderThickness="1"
                            CornerRadius="22" Padding="20" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ПАРОЛЬ ПРИЛОЖЕНИЯ" FontSize="10" FontFamily="Segoe UI Semibold"
                                       Foreground="{StaticResource NothingMutedDarkBrush}"/>
                            <TextBlock Text="Обычный пароль от аккаунта не подойдёт. Создайте отдельный пароль в Яндекс ID → Безопасность → Пароли приложений."
                                       Foreground="{StaticResource NothingMutedDarkBrush}" FontSize="12"
                                       FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Button Style="{StaticResource NothingDarkPillButton}"
                                    HorizontalAlignment="Left" Margin="0,14,0,0"
                                    Click="OpenAppPasswordHelp_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}"
                                               FontSize="13" Foreground="{StaticResource NothingWhiteBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="ОТКРЫТЬ ИНСТРУКЦИЮ" Style="{StaticResource NothingDarkPillLabel}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- МОДАЛЬНЫЙ СЛОЙ: МЕНЮ АККАУНТА И КАРТОЧКА ПОДТВЕРЖДЕНИЯ -->
        <Grid x:Name="ModalOverlay" Canvas.ZIndex="200" Visibility="Collapsed">
            <Border x:Name="ModalBackdrop" Background="#B3000000" Tap="ModalOverlay_Tap"/>
            <Border x:Name="AccountMenuCard" Style="{StaticResource NothingSheetCard}"
                    VerticalAlignment="Bottom" Margin="16,0,16,24" Tap="AccountMenuCard_Tap">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="24"/>
                </Border.RenderTransform>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="АККАУНТ" Style="{StaticResource NothingSheetCaption}"/>
                            <TextBlock x:Name="AccountMenuLogin" Text="Не указан" Style="{StaticResource NothingSheetTitle}"
                                       FontSize="22" Margin="0,4,0,0" TextTrimming="WordEllipsis"/>
                            <TextBlock Text="Яндекс.Диск · WebDAV" Style="{StaticResource NothingRowCaption}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource NothingCloseButton}"
                                Click="AccountMenuClose_Click" VerticalAlignment="Top">
                            <TextBlock Text="&#xE4F6;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                       Foreground="{StaticResource NothingInkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="ХРАНИЛИЩЕ" Style="{StaticResource NothingSheetCaption}" Margin="0,24,0,0"/>
                    <Border x:Name="AccountStorageTrack" Height="4" CornerRadius="2" Background="#E4E4E1"
                            Margin="0,12,0,8" SizeChanged="AccountStorageTrack_SizeChanged">
                        <Border x:Name="AccountStorageFill" Background="{StaticResource NothingInkBrush}"
                                CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                    </Border>
                    <TextBlock x:Name="AccountStorageText" Text="Загрузка..." Style="{StaticResource NothingRowCaption}"/>

                    <Border Height="1" Background="{StaticResource NothingBorderLightBrush}" Margin="0,20,0,12"/>

                    <Button Style="{StaticResource NothingRowButton}" Click="AccountMenuRefresh_Click">
                        <Grid Height="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="#F0F0EE" VerticalAlignment="Center">
                                <TextBlock Text="&#xE094;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                           Foreground="{StaticResource NothingInkBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Обновить данные" Style="{StaticResource NothingRowTitle}"/>
                                <TextBlock Text="Папка и занятое место" Style="{StaticResource NothingRowCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}"
                                       FontSize="18" Foreground="#9A9A9A" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource NothingRowButton}" Click="AccountMenuLogout_Click" Margin="0,4,0,0">
                        <Grid Height="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource NothingRedSoftBrush}" VerticalAlignment="Center">
                                <TextBlock Text="&#xE42A;" FontFamily="{StaticResource PhosphorFont}" FontSize="20"
                                           Foreground="{StaticResource NothingRedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Выйти" Style="{StaticResource NothingRowTitle}"
                                           Foreground="{StaticResource NothingRedBrush}"/>
                                <TextBlock Text="Отключить аккаунт на устройстве" Style="{StaticResource NothingRowCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE13A;" FontFamily="{StaticResource PhosphorFont}"
                                       FontSize="18" Foreground="{StaticResource NothingRedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- КАРТОЧКА ПОДТВЕРЖДЕНИЯ: ТО ЖЕ МЕСТО, ЧТО У МЕНЮ АККАУНТА -->
            <Border x:Name="NothingDialogCard" Style="{StaticResource NothingSheetCard}"
                    VerticalAlignment="Bottom" Margin="16,0,16,24" Tap="NothingDialogCard_Tap"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform X="480"/>
                </Border.RenderTransform>

                <StackPanel>
                    <TextBlock x:Name="NothingDialogTitle" Style="{StaticResource NothingDialogTitle}"/>
                    <TextBlock x:Name="NothingDialogMessage" Style="{StaticResource NothingDialogBody}" Margin="0,10,0,0"/>

                    <Border x:Name="NothingDialogInputBorder" Visibility="Collapsed" Background="#F2F2F0"
                            CornerRadius="16" Margin="0,18,0,0" Padding="14,0">
                        <TextBox x:Name="NothingDialogInput" Height="50" BorderThickness="0"
                                 Background="Transparent" Foreground="{StaticResource NothingInkBrush}"
                                 FontSize="17" FontFamily="Segoe UI" Padding="0"
                                 VerticalContentAlignment="Center" MaxLength="255"
                                 KeyDown="NothingDialogInput_KeyDown"/>
                    </Border>

                    <TextBlock x:Name="NothingDialogError" Visibility="Collapsed" FontFamily="Segoe UI"
                               FontSize="12" Foreground="{StaticResource NothingRedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="NothingDialogSecondaryButton" Style="{StaticResource NothingSecondaryButton}"
                                Click="NothingDialogSecondary_Click" Margin="0,0,8,0"/>
                        <Button x:Name="NothingDialogPrimaryButton" Style="{StaticResource NothingPrimaryButton}"
                                Click="NothingDialogPrimary_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>